# Copy to .env (git-ignored). Keys are only ever read by the server.
#
# Two providers. FASTROUTER is one OpenAI-compatible endpoint in front of a
# couple of hundred models; GOOGLE talks to @google/genai directly. Leave
# MODEL_PROVIDER unset and a FastRouter key decides it, because nobody sets
# that key by accident.
MODEL_PROVIDER=fastrouter

# --- fastrouter ------------------------------------------------------------
# https://fastrouter.ai — keys look like sk-v1-...
FASTROUTER_API_KEY=sk-v1-replace-me
# FASTROUTER_BASE_URL=https://go.fastrouter.ai/api/v1

# Not uniform, because the roles are not. DESIGN only runs when a world is
# being built — about 37k in / 8k out on the real prompts, so ~16c a world on
# Argon, which is what every prompt in prompts.ts was written against. TEXT and
# FAST run per turn once a world is open, so they stay cheap.
# `npm run models` prints the live price of each of these.
DESIGN_MODEL=google/gemini-4-argon
# Every role is Gemini: the hackathon requires it, and the pitch says so.
TEXT_MODEL=google/gemini-3.8-flash
FAST_MODEL=google/gemini-3.5-flash-lite
IMAGE_MODEL=google/gemini-nano-banana-2.1
EMBED_MODEL=google/gemini-embedding-001

# --- google ----------------------------------------------------------------
# Only needed with MODEL_PROVIDER=google. Get one from AI Studio.
GEMINI_API_KEY=AIza-replace-me
# DESIGN_MODEL=gemini-4-argon
# TEXT_MODEL=gemini-3.8-flash
# FAST_MODEL=gemini-3.5-flash-lite
# IMAGE_MODEL=gemini-nano-banana-2.1
# EMBED_MODEL=gemini-embedding-2

# DESIGN_MODEL builds worlds (curriculum, writers' room, draft judge) and is the
# slow, expensive one. Never point the Oracle's RAG answers at it: those lessons
# need a model that visibly gets distracted at k=8.

# Painting is the expensive part of a build: about twenty images, which on a
# measured run cost roughly twice every text call put together. Turn it off
# while iterating on story or mechanics — the scenes play on placeholder art.
# PAINT_ART=off

# Paint through a different provider from the text. Cloud Run sets
# IMAGE_PROVIDER=fastrouter: a new Vertex project gets about one Nano Banana
# image a minute, the router paints three at once. Needs FASTROUTER_API_KEY.
# IMAGE_PROVIDER=fastrouter

# Safety rails
DAILY_CALL_CAP=500
DESIGN_DAILY_CAP=200
PORT=8787
NODE_ENV=development
