# Copy to .env (git-ignored). The key is only ever read by the server.
GEMINI_API_KEY=your-key-here

# Model IDs — verify in AI Studio before the demo.
# DESIGN_MODEL builds worlds (curriculum, writers' room, draft judge) and is the
# slow, expensive one. Never point the Oracle's RAG answers at it.
DESIGN_MODEL=gemini-4-argon
TEXT_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
IMAGE_MODEL=gemini-nano-banana-2.1
EMBED_MODEL=gemini-embedding-2

# Safety rails
DAILY_CALL_CAP=500
DESIGN_DAILY_CAP=200
PORT=8787
NODE_ENV=development
