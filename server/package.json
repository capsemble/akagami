{
  "name": "@chapter-quest/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "models": "tsx scripts/models.ts",
    "design": "tsx scripts/design.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@chapter-quest/shared": "^0.1.0",
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
